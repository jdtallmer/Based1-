# Hosted Postgres (Supabase). In Supabase: Project Settings > Database >
# Connect > choose "Prisma" to get both of these pre-formatted.
# DATABASE_URL = pooled connection (port 6543, ?pgbouncer=true) - used by the app.
# DIRECT_URL   = direct connection (port 5432) - used only by `prisma migrate`.
DATABASE_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.xxxx.supabase.co:5432/postgres"

# Password required to log into the dashboard (single user).
APP_PASSWORD="changeme"

# Random 32+ char secret used to encrypt the login session cookie.
SESSION_SECRET="replace-with-a-long-random-string"

# Used by the AI cover letter generator (Settings > Cover Letter Generator).
ANTHROPIC_API_KEY=""
