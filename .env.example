# Local dev: SQLite file, no setup required.
# Production: swap prisma/schema.prisma provider to "postgresql" and point this
# at a Neon/Supabase connection string instead.
DATABASE_URL="file:./dev.db"

# Password required to log into the dashboard (single user).
APP_PASSWORD="changeme"

# Random 32+ char secret used to encrypt the login session cookie.
SESSION_SECRET="replace-with-a-long-random-string"

# Used by the AI cover letter generator (Settings > Cover Letter Generator).
ANTHROPIC_API_KEY=""
