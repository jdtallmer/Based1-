// Hosted Postgres (Supabase). DATABASE_URL is the pooled connection (used by
// the running app); DIRECT_URL is the direct connection (used by `prisma
// migrate`, which pooled connections don't support). See README.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ApplicationStatus {
  APPLIED
  RESPONDED
  INTERVIEW_SCHEDULED
  OFFER
  REJECTED
  GHOSTED
}

model Application {
  id           String            @id @default(cuid())
  company      String
  title        String
  link         String
  status       ApplicationStatus @default(APPLIED)
  appliedDate  DateTime          @default(now())
  lastActivity DateTime          @default(now())
  archived     Boolean           @default(false)
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model NewRole {
  id         String   @id @default(cuid())
  company    String
  title      String
  postedDate DateTime
  link       String
  jobId      String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model WatchlistCompany {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model Settings {
  id           String  @id @default("singleton")
  resumeText   String?
  linkedinUrl  String?
  resumeDocUrl String?
}
